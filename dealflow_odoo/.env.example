# DealFlow360 — Environment Variable Reference
# Copy this file to .env and adjust values for your environment.
# The Odoo process must have these variables available at startup.
#
# ─────────────────────────────────────────────────────────────────────────────
# Decision Engine PostgreSQL Database
# ─────────────────────────────────────────────────────────────────────────────

# Full DSN for the DealFlow360 PostgreSQL Decision Engine database.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://dealflow_user:dealflow_pass@localhost:5432/dealflow360

# Minimum number of persistent connections in the pool.
DB_MIN_CONNECTIONS=2

# Maximum number of connections the pool will open simultaneously.
DB_MAX_CONNECTIONS=10

# Set to "false" / "0" / "no" to disable all Decision Engine DB writes.
# When disabled, the Odoo module runs in Odoo-only mode (no PostgreSQL calls).
# Useful for demo environments or when psycopg2 is not installed.
DEALFLOW_DB_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# Path Override (optional — for non-standard deployments)
# ─────────────────────────────────────────────────────────────────────────────

# Absolute path to the DealFlow360 workspace root directory.
# Only needed if the auto-detection in dealflow_odoo/__init__.py fails
# (e.g. symlinked addons, Docker volume mounts, etc.).
# DEALFLOW_WORKSPACE_ROOT=/opt/dealflow360

# ─────────────────────────────────────────────────────────────────────────────
# Odoo Standard (reference only — configure in odoo.conf as usual)
# ─────────────────────────────────────────────────────────────────────────────

# These are standard Odoo variables — listed here for convenience.
# ODOO_DB_HOST=localhost
# ODOO_DB_PORT=5432
# ODOO_DB_USER=odoo
# ODOO_DB_PASSWORD=odoo
