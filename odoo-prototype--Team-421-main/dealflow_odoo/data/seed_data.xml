<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ================================================================= -->
        <!-- 1. CUSTOMERS                                                      -->
        <!-- ================================================================= -->
        <record id="partner_customer_acme" model="res.partner">
            <field name="name">Acme Corp</field>
            <field name="is_company">True</field>
            <field name="customer_rank">1</field>
            <field name="email">contact@acme.example.com</field>
            <field name="phone">+1 (555) 019-2831</field>
            <field name="street">100 Enterprise Way</field>
            <field name="city">Austin</field>
            <field name="country_id" ref="base.us"/>
        </record>

        <record id="partner_customer_beta" model="res.partner">
            <field name="name">Beta Industries</field>
            <field name="is_company">True</field>
            <field name="customer_rank">1</field>
            <field name="email">procurement@betaindustries.example.com</field>
            <field name="phone">+1 (555) 024-5512</field>
            <field name="street">450 Industrial Blvd</field>
            <field name="city">Chicago</field>
            <field name="country_id" ref="base.us"/>
        </record>

        <record id="partner_customer_nova" model="res.partner">
            <field name="name">Nova Retail</field>
            <field name="is_company">True</field>
            <field name="customer_rank">1</field>
            <field name="email">orders@novaretail.example.com</field>
            <field name="phone">+1 (555) 038-7744</field>
            <field name="street">789 Commerce St</field>
            <field name="city">New York</field>
            <field name="country_id" ref="base.us"/>
        </record>

        <!-- ================================================================= -->
        <!-- 2. PRODUCT CATEGORIES                                             -->
        <!-- ================================================================= -->
        <record id="product_category_hardware" model="product.category">
            <field name="name">Hardware</field>
            <field name="parent_id" ref="product.product_category_all"/>
        </record>

        <record id="product_category_service" model="product.category">
            <field name="name">Service</field>
            <field name="parent_id" ref="product.product_category_all"/>
        </record>

        <record id="product_category_subscription" model="product.category">
            <field name="name">Subscription</field>
            <field name="parent_id" ref="product.product_category_all"/>
        </record>

        <!-- ================================================================= -->
        <!-- 3. PRODUCTS                                                       -->
        <!-- ================================================================= -->
        <!-- Hardware: Laptop (1200 list, 800 cost) -->
        <record id="product_laptop" model="product.product">
            <field name="name">Laptop</field>
            <field name="default_code">LAPTOP-01</field>
            <field name="categ_id" ref="product_category_hardware"/>
            <field name="list_price">1200.0</field>
            <field name="standard_price">800.0</field>
            <field name="type">consu</field>
            <field name="is_storable">True</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">True</field>
        </record>

        <!-- Hardware: Monitor (300 list, 180 cost) -->
        <record id="product_monitor" model="product.product">
            <field name="name">Monitor</field>
            <field name="default_code">MON-01</field>
            <field name="categ_id" ref="product_category_hardware"/>
            <field name="list_price">300.0</field>
            <field name="standard_price">180.0</field>
            <field name="type">consu</field>
            <field name="is_storable">True</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">True</field>
        </record>

        <!-- Hardware: Docking Station (150 list, 80 cost) -->
        <record id="product_docking_station" model="product.product">
            <field name="name">Docking Station</field>
            <field name="default_code">DOCK-01</field>
            <field name="categ_id" ref="product_category_hardware"/>
            <field name="list_price">150.0</field>
            <field name="standard_price">80.0</field>
            <field name="type">consu</field>
            <field name="is_storable">True</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">True</field>
        </record>

        <!-- Service: Implementation Service (150/hr) -->
        <record id="product_implementation_service" model="product.product">
            <field name="name">Implementation Service</field>
            <field name="default_code">SRV-IMPL</field>
            <field name="categ_id" ref="product_category_service"/>
            <field name="list_price">150.0</field>
            <field name="standard_price">90.0</field>
            <field name="type">service</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
        </record>

        <!-- Subscription: Premium Support (recurring monthly, 500/mo) -->
        <record id="product_premium_support" model="product.product">
            <field name="name">Premium Support</field>
            <field name="default_code">SUB-PREM</field>
            <field name="categ_id" ref="product_category_subscription"/>
            <field name="list_price">500.0</field>
            <field name="standard_price">250.0</field>
            <field name="type">service</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
        </record>

        <!-- Service: Extended Warranty (250) -->
        <record id="product_extended_warranty" model="product.product">
            <field name="name">Extended Warranty</field>
            <field name="default_code">SRV-WARR</field>
            <field name="categ_id" ref="product_category_service"/>
            <field name="list_price">250.0</field>
            <field name="standard_price">100.0</field>
            <field name="type">service</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
        </record>

        <!-- ================================================================= -->
        <!-- 4. WAREHOUSES                                                     -->
        <!-- ================================================================= -->
        <record id="warehouse_main" model="stock.warehouse">
            <field name="name">Main Warehouse</field>
            <field name="code">WH1</field>
            <field name="partner_id" ref="base.main_partner"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="warehouse_east" model="stock.warehouse">
            <field name="name">East Depot</field>
            <field name="code">WH2</field>
            <field name="partner_id" ref="base.main_partner"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- ================================================================= -->
        <!-- 5. STOCK QUANTS (Inventory configured for Warehouse Split)        -->
        <!-- Laptop: 9 in WH1 and 6 in WH2 (15-unit order MUST split!)         -->
        <!-- ================================================================= -->
        <record id="stock_quant_laptop_wh1" model="stock.quant">
            <field name="product_id" ref="product_laptop"/>
            <field name="location_id" model="stock.location" search="[('location_id.name', '=', 'WH1'), ('name', '=', 'Stock')]"/>
            <field name="inventory_quantity">9.0</field>
            <field name="quantity">9.0</field>
        </record>

        <record id="stock_quant_laptop_wh2" model="stock.quant">
            <field name="product_id" ref="product_laptop"/>
            <field name="location_id" model="stock.location" search="[('location_id.name', '=', 'WH2'), ('name', '=', 'Stock')]"/>
            <field name="inventory_quantity">6.0</field>
            <field name="quantity">6.0</field>
        </record>

        <record id="stock_quant_monitor_wh1" model="stock.quant">
            <field name="product_id" ref="product_monitor"/>
            <field name="location_id" model="stock.location" search="[('location_id.name', '=', 'WH1'), ('name', '=', 'Stock')]"/>
            <field name="inventory_quantity">20.0</field>
            <field name="quantity">20.0</field>
        </record>

        <record id="stock_quant_monitor_wh2" model="stock.quant">
            <field name="product_id" ref="product_monitor"/>
            <field name="location_id" model="stock.location" search="[('location_id.name', '=', 'WH2'), ('name', '=', 'Stock')]"/>
            <field name="inventory_quantity">10.0</field>
            <field name="quantity">10.0</field>
        </record>

        <record id="stock_quant_docking_wh1" model="stock.quant">
            <field name="product_id" ref="product_docking_station"/>
            <field name="location_id" model="stock.location" search="[('location_id.name', '=', 'WH1'), ('name', '=', 'Stock')]"/>
            <field name="inventory_quantity">25.0</field>
            <field name="quantity">25.0</field>
        </record>

        <record id="stock_quant_docking_wh2" model="stock.quant">
            <field name="product_id" ref="product_docking_station"/>
            <field name="location_id" model="stock.location" search="[('location_id.name', '=', 'WH2'), ('name', '=', 'Stock')]"/>
            <field name="inventory_quantity">15.0</field>
            <field name="quantity">15.0</field>
        </record>

    </data>
</odoo>
